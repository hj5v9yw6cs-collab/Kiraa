# Contact form delivery through Resend (https://resend.com).
# Without these the form shows its error state with a Telegram/mailto fallback.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Used by the sitemap, canonical URLs and Open Graph. Set before going live.
NEXT_PUBLIC_SITE_URL=https://kiragorst.vercel.app
